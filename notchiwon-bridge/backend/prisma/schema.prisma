// 노치원 픽업 브릿지 시스템 - Prisma 스키마
// 참고 문서: 노치원_AI_브릿지_아키텍처_데이터모델.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DementiaStage {
  MILD // 경도
  MODERATE // 중등도
  SEVERE // 중증
}

enum VisitStatus {
  SCHEDULED // 예정
  EN_ROUTE // 이동중
  SESSION_ACTIVE // 세션진행중
  COMPLETED // 완료
  CANCELLED // 취소
}

enum SessionEndReason {
  CAREGIVER_ARRIVED // 조무사도착
  ELDER_DECLINED // 노인거부
  TIMEOUT // 타임아웃
  ERROR // 오류
}

enum EmotionTag {
  STABLE // 안정
  SLIGHTLY_ANXIOUS // 약간불안
  UNUSUAL // 평소와다름
}

enum KeywordCategory {
  FAMILY // 가족
  HOBBY // 취미
  MEMORY // 추억
  FOOD // 음식
  HEALTH_OTHER // 건강기타
}

enum EmotionTone {
  POSITIVE // 긍정
  NEUTRAL // 중립
  AVOIDANT // 회피
}

enum Speaker {
  ELDER
  AI
}

enum EscalationTriggerType {
  FALL_MENTION // 낙상언급
  PAIN_COMPLAINT // 통증호소
  SELF_OR_OTHER_HARM // 자타해관련
  OTHER_ANOMALY // 기타이상
}

model Guardian {
  id                       String   @id @default(uuid())
  name                     String
  phone                    String
  notificationPreference   Json?    @map("notification_preference")
  elders                   Elder[]
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("guardian")
}

model DaycareCenter {
  id          String       @id @default(uuid())
  name        String
  address     String?
  elders      Elder[]
  caregivers  Caregiver[]
  createdAt   DateTime     @default(now()) @map("created_at")

  @@map("daycare_center")
}

model Elder {
  id                  String        @id @default(uuid())
  name                String
  birthDate           DateTime      @map("birth_date")
  dementiaStage       DementiaStage @map("dementia_stage")
  preferredTtsVoice   String?       @map("preferred_tts_voice")

  guardian    Guardian       @relation(fields: [guardianId], references: [id])
  guardianId  String         @map("guardian_id")

  center      DaycareCenter  @relation(fields: [centerId], references: [id])
  centerId    String         @map("center_id")

  visits         Visit[]
  keywordTags    KeywordTag[]
  sessions       ConversationSession[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("elder")
}

model Caregiver {
  id        String     @id @default(uuid())
  name      String

  center    DaycareCenter @relation(fields: [centerId], references: [id])
  centerId  String        @map("center_id")

  visits    Visit[]

  createdAt DateTime @default(now()) @map("created_at")

  @@map("caregiver")
}

model Visit {
  id                  String      @id @default(uuid())

  elder       Elder     @relation(fields: [elderId], references: [id])
  elderId     String    @map("elder_id")

  caregiver     Caregiver @relation(fields: [caregiverId], references: [id])
  caregiverId   String    @map("caregiver_id")

  scheduledTime       DateTime    @map("scheduled_time")
  etaCurrent          DateTime?   @map("eta_current")
  status              VisitStatus @default(SCHEDULED)
  actualArrivalTime   DateTime?   @map("actual_arrival_time")

  session     ConversationSession?

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([elderId, scheduledTime])
  @@map("visit")
}

model ConversationSession {
  id                    String            @id @default(uuid())

  visit       Visit   @relation(fields: [visitId], references: [id])
  visitId     String  @unique @map("visit_id")

  elder       Elder   @relation(fields: [elderId], references: [id])
  elderId     String  @map("elder_id")

  startedAt             DateTime          @default(now()) @map("started_at")
  endedAt               DateTime?         @map("ended_at")
  triggerEtaMinutes     Int               @map("trigger_eta_minutes")
  overallEmotionTag     EmotionTag?       @map("overall_emotion_tag")
  endedReason           SessionEndReason? @map("ended_reason")

  utterances        Utterance[]
  briefingReport    BriefingReport?
  escalationEvents  EscalationEvent[]

  @@map("conversation_session")
}

model Utterance {
  id            String   @id @default(uuid())

  session       ConversationSession @relation(fields: [sessionId], references: [id])
  sessionId     String              @map("session_id")

  speaker       Speaker
  text          String
  audioRef      String?  @map("audio_ref")
  emotionScore  Float?   @map("emotion_score")
  flaggedRisk   Boolean  @default(false) @map("flagged_risk")

  escalationEvents  EscalationEvent[]

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([sessionId, createdAt])
  @@map("utterance")
}

model KeywordTag {
  id                  String          @id @default(uuid())

  elder       Elder   @relation(fields: [elderId], references: [id])
  elderId     String  @map("elder_id")

  keyword             String
  category            KeywordCategory
  score               Float           @default(0)
  emotionTone         EmotionTone     @default(NEUTRAL) @map("emotion_tone")
  lastMentionedAt     DateTime        @map("last_mentioned_at")
  mentionCountTotal   Int             @default(1) @map("mention_count_total")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([elderId, keyword])
  @@index([elderId, score(sort: Desc)])
  @@map("keyword_tag")
}

model BriefingReport {
  id      String @id @default(uuid())

  session     ConversationSession @relation(fields: [sessionId], references: [id])
  sessionId   String              @unique @map("session_id")

  summaryText           String   @map("summary_text")
  topKeywords           Json     @map("top_keywords")
  emotionFlag           String?  @map("emotion_flag")
  generatedAt           DateTime @default(now()) @map("generated_at")
  readByCaregiverAt     DateTime? @map("read_by_caregiver_at")

  @@map("briefing_report")
}

model EscalationEvent {
  id      String @id @default(uuid())

  session     ConversationSession @relation(fields: [sessionId], references: [id])
  sessionId   String              @map("session_id")

  utterance     Utterance? @relation(fields: [utteranceId], references: [id])
  utteranceId   String?    @map("utterance_id")

  triggerType       EscalationTriggerType @map("trigger_type")
  notifiedTargets   Json                  @map("notified_targets")

  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  @@map("escalation_event")
}
