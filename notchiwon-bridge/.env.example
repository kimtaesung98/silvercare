# --- 서버 (Go) ---
PORT=8000
LOG_LEVEL=info

# --- 데이터베이스 ---
DATABASE_URL="postgres://notchiwon:notchiwon_dev_pw@localhost:5432/notchiwon_bridge?sslmode=disable"
# 서버 시작 시 goose 마이그레이션 적용
MIGRATE_ON_START=true

# --- 인증 ---
# 조무사 액세스 토큰 서명 키 (32바이트 이상, 예: openssl rand -base64 48)
AUTH_SECRET=""
CAREGIVER_TOKEN_TTL=12h

# --- Redis (실시간 세션/ETA 캐시) ---
REDIS_URL="redis://localhost:6379"

# --- AI / LLM ---
ANTHROPIC_API_KEY=""
CLAUDE_CONVERSATION_MODEL="claude-sonnet-5-5"
CLAUDE_SUMMARY_MODEL="claude-haiku-4-5-20251001"
# 대화 턴 시간 제한: 1번 문장이 늦으면 추임새, 더 늦으면 대체 문장, 한 턴 최대 시간
CONVERSATION_FILLER_AFTER=2s
CONVERSATION_FIRST_SENTENCE_TIMEOUT=6s
CONVERSATION_TURN_TIMEOUT=20s

# --- 지도/ETA ---
# 카카오모빌리티 길찾기 REST 키. 비워 두면 예정 시각 기준으로 ETA를 어림합니다.
KAKAO_MOBILITY_API_KEY=""

# --- 음성 (STT/TTS) ---
NAVER_CLOVA_CLIENT_ID=""
NAVER_CLOVA_CLIENT_SECRET=""

# --- 푸시 알림 (FCM HTTP v1) ---
# Firebase 서비스 계정 JSON 파일 경로. 비워 두면 위급 알림은 앱의 미확인 목록으로만 보입니다.
FCM_CREDENTIALS_FILE=""

# --- ETA 트리거 임계값 (분 단위) ---
SESSION_TRIGGER_ETA_MINUTES=15
# "오늘 방문"의 기준 시간대
TIME_ZONE=Asia/Seoul
