TMAP_API_KEY=""

# --- 음성 (STT/TTS) ---
NAVER_CLOVA_CLIENT_ID=""
NAVER_CLOVA_CLIENT_SECRET=""

# --- 푸시 알림 ---
FCM_SERVER_KEY=""

# --- ETA 트리거 임계값 (분 단위) ---
