# --- 서버 (Go) ---
PORT=8000
LOG_LEVEL=info

# --- 데이터베이스 ---
DATABASE_URL="postgres://notchiwon:notchiwon_dev_pw@localhost:5432/notchiwon_bridge?sslmode=disable"
# 서버 시작 시 goose 마이그레이션 적용
MIGRATE_ON_START=true

# --- 인증 ---
# 조무사 액세스 토큰 서명 키 (32바이트 이상, 예: openssl rand -base64 48)
AUTH_SECRET=""
CAREGIVER_TOKEN_TTL=12h

# --- Redis (실시간 세션/ETA 캐시) ---
REDIS_URL="redis://localhost:6379"

# --- AI / LLM ---
ANTHROPIC_API_KEY=""
CLAUDE_CONVERSATION_MODEL="claude-sonnet-5-5"
CLAUDE_SUMMARY_MODEL="claude-haiku-4-5-20251001"
# 대화 턴 시간 제한: 1번 문장이 늦으면 추임새, 더 늦으면 대체 문장, 한 턴 최대 시간
CONVERSATION_FILLER_AFTER=2s
CONVERSATION_FIRST_SENTENCE_TIMEOUT=6s
CONVERSATION_TURN_TIMEOUT=20s

# --- 지도/ETA ---
# 카카오모빌리티 길찾기 REST 키. 비워 두면 예정 시각 기준으로 ETA를 어림합니다.
KAKAO_MOBILITY_API_KEY=""

# --- 음성 (Amazon Transcribe 인식 + Polly 목소리) ---
# AWS 자격 증명: `aws login`으로 만든 프로필 이름, 또는 액세스 키 두 개.
# 비워 두면 서버 음성이 없고 태블릿이 내장 음성 인식·TTS로 대화합니다.
AWS_PROFILE=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="ap-southeast-2"
TRANSCRIBE_LANGUAGE="ko-KR"
# 한국어 목소리: Seoyeon(standard/neural/generative) 또는 Jihye(neural). 빠르기는 SSML 비율.
POLLY_VOICE="Seoyeon"
POLLY_ENGINE="neural"
POLLY_RATE="90%"
# 개발용: 서버가 받은 어르신 녹음을 WAV로 이 폴더에 남깁니다 (afplay로 들어 보기).
# 어르신 목소리라 실제 운영에서는 비워 두세요.
DEBUG_AUDIO_DIR=""

# --- 푸시 알림 (FCM HTTP v1) ---
# Firebase 서비스 계정 JSON 파일 경로. 비워 두면 위급 알림은 앱의 미확인 목록으로만 보입니다.
FCM_CREDENTIALS_FILE=""

# --- ETA 트리거 임계값 (분 단위) ---
SESSION_TRIGGER_ETA_MINUTES=15
# "오늘 방문"의 기준 시간대
TIME_ZONE=Asia/Seoul

# --- 말동무 모드 (노치원 하원 후 안부 대화) ---
# 어르신 한 분의 하루 토큰 한도. 보호자가 앱에서 어르신별로 다르게 정할 수 있습니다.
COMPANION_DAILY_TOKEN_LIMIT=60000
# 이 시간 동안 어르신 말씀이 없으면 대화를 마칩니다.
COMPANION_IDLE_AFTER=5m
# 보호자에게 하루 소식을 보내는 현지 시각 (취침 시간이 더 이르면 그때 보냅니다)
COMPANION_DIGEST_AT=21:00

# =====================================================================
# 아래는 서버가 아니라 개발 스크립트(scripts/dev.sh)가 앱을 띄울 때 읽는 값입니다.
# 값을 채운 뒤 `scripts/dev.sh check`로 빠진 것을 확인하세요.
# =====================================================================

# 앱이 접속할 서버 주소. 에뮬레이터는 10.0.2.2, 실기기는 PC의 사설 IP (예: http://192.168.0.10:8000)
APP_SERVER_URL="http://10.0.2.2:8000"

# 어르신 태블릿 기기 토큰. `scripts/dev.sh seed`가 자동으로 채웁니다.
DEVICE_TOKEN=""

# 데모 로그인 정보. `scripts/dev.sh seed`가 자동으로 채웁니다 (참고용, 앱 로그인 화면에 입력).
CAREGIVER_LOGIN=""
CAREGIVER_PASSWORD=""
GUARDIAN_LOGIN=""
GUARDIAN_PASSWORD=""

# Firebase 앱 값 (google-services.json에서). 비우면 푸시 없이 실행합니다.
FIREBASE_API_KEY=""            # client[].api_key[0].current_key
FIREBASE_SENDER_ID=""          # project_info.project_number
FIREBASE_PROJECT_ID=""         # project_info.project_id
CAREGIVER_FIREBASE_APP_ID=""   # kr.notchiwon.caregiver 의 client_info.mobilesdk_app_id
GUARDIAN_FIREBASE_APP_ID=""    # kr.notchiwon.guardian 의 client_info.mobilesdk_app_id

# 앱을 설치할 기기 id (`scripts/dev.sh devices`로 확인, 예: emulator-5554). 비우면 flutter가 묻습니다.
TABLET_DEVICE=""
CAREGIVER_DEVICE=""
GUARDIAN_DEVICE=""

# 태블릿이 어르신 말을 알아듣는 방식: device(태블릿 내장 음성 인식) 또는 server(Amazon Transcribe).
# 비우면 AWS 자격 증명이 있을 때 server, 없을 때 device. AI 목소리는 서버 음성이 없으면 태블릿 TTS로 읽습니다.
TABLET_SPEECH=""
