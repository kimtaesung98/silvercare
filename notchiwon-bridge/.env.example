# --- 서버 ---
NODE_ENV=development
PORT=3000

# --- 데이터베이스 ---
DATABASE_URL="postgresql://notchiwon:notchiwon_dev_pw@localhost:5432/notchiwon_bridge?schema=public"

# --- Redis (실시간 세션/ETA 캐시) ---
REDIS_URL="redis://localhost:6379"

# --- AI / LLM ---
ANTHROPIC_API_KEY=""
CLAUDE_CONVERSATION_MODEL="claude-sonnet-4-6"
